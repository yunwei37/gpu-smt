{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "gpu-smt-cuopt-20261017",
    "namespace": "coder",
    "labels": {
      "app.kubernetes.io/name": "gpu-smt-arithmetic-benchmark"
    },
    "annotations": {
      "admission.yunwei37.com/approval-ref": "gpu-smt/artifacts/arithmetic-counterexample-2026-10-23/plan.md",
      "admission.yunwei37.com/user-words": "用 GPU 给失败的证明「找反例、提前判死」"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "nodeSelector": {
          "fleet.yunwei37.com/gpu": "rtx5090"
        },
        "runtimeClassName": "nvidia",
        "containers": [
          {
            "name": "points",
            "image": "nvidia/cuopt@sha256:ed854f295ebc2323beee947cd3ade3cbab1aae6c559694983666ce4369365734",
            "command": [
              "python3",
              "-u",
              "-c",
              "import base64,json,pathlib,os,sys;d=json.loads(base64.b64decode(''));p=pathlib.Path(\"/tmp/gpu-smt-point-provider\");p.mkdir();[(p/n).write_text(s)for n,s in d.items()];os.execv(sys.executable,[sys.executable,\"-u\",str(p/\"point-provider.py\"),\"--ptx\",str(p/\"points.ptx\")])"
            ],
            "resources": {
              "limits": {
                "nvidia.com/gpu": 1
              }
            }
          }
        ]
      }
    }
  }
}
