open Topology Filter Real Complex TopologicalSpace Finset                       
open scoped BigOperators                                                        
                                                                                
/-- If $r$ is rational $(r \neq 0)$ and $x$ is irrational, prove that $rx$ is   
irrational.-/                                                                   
theorem exercise_1_1b                                                           
(x : ℝ)                                                                         
(y : ℚ)                                                                         
(h : y ≠ 0)                                                                     
: ( Irrational x ) -> Irrational ( x * y ) :=  by                               
  /-                                                                            
  Given a rational number \( r \) (where \( r \neq 0 \)) and an irrational      
number \( x \), we need to prove that \( rx \) is irrational. Assume for        
contradiction that \( rx \) is rational. Then there exists a rational number \( 
q \) such that \( rx = q \). This implies \( x = \frac{q}{r} \), which is a     
rational number since \( q \) and \( r \) are both rational. This contradicts   
the assumption that \( x \) is irrational. Therefore, \( rx \) must be          
irrational.                                                                     
  -/                                                                            
  -- Assume for contradiction that x is rational and y is rational (since y is a
rational number and not zero).                                                  
  intro hx                                                                      
  -- Assume for contradiction that rx is rational.                              
  intro h_rat                                                                   
  -- Obtain a rational number q such that rx = q.                               
  obtain ⟨q, hq⟩ := h_rat                                                       
  -- Since r is non-zero, we can cancel r from both sides of the equation rx =  
q.                                                                              
  apply hx                                                                      
  -- Use the fact that r is non-zero to cancel r from both sides.               
  use q / y                                                                     
  -- Simplify the equation to show that x = q / r, which is rational.           
  field_simp [h] at hq ⊢                                                        
  -- This implies x is rational, contradicting the assumption that x is         
irrational.                                                                     
  exact hq                                                                      
