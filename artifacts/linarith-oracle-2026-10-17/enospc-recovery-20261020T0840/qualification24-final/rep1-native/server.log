              -- Simplify the absolute values based on the non-negativity or    
non-positivity.                                                                 
              simp_all only [abs_of_nonneg, abs_of_nonpos, sub_nonneg,          
sub_nonpos] <;>                                                                 
                -- Use algebraic manipulations and inequalities to show the     
desired result.                                                                 
                nlinarith [sq_nonneg (a - b), sq_nonneg (a - c), sq_nonneg (b - 
c),                                                                             
                  sq_nonneg (a + b), sq_nonneg (a + c), sq_nonneg (b + c)]      
