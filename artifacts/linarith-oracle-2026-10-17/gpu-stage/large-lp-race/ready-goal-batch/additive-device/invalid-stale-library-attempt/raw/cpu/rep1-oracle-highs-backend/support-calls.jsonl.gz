5}{12} x^{24} - \\frac{1}{4} x^{12} + x^{10} - \\frac{1}{3} x^9 + 2 x^3\\)\n  2. \\(-\\frac{5}{12} x^{24} - \\frac{1}{4} x^{12} + x^{10} - \\frac{1}{3} x^9 + 2 x^3 \\leq 2\\)\n  Given the constraints \\(0 \\leq x \\leq 1\\), we can use algebraic simplification and numerical bounds to verify these inequalities.\n  -/\n  constructor\n  -- Prove the first inequality: 0 \u2264 -5/12 * x^24 - 1/4 * x^12 + x^10 - 1/3 * x^9 + 2 * x^3\n  -- Using the fact that x \u2208 [0, 1], we can use numerical and algebraic bounds to show this inequality holds.\n  all_goals nlinarith [pow_nonneg (sub_nonneg.mpr hx.1) 3, pow_nonneg (sub_nonneg.mpr hx.1) 6, pow_nonneg (sub_nonneg.mpr hx.1) 9, pow_nonneg (sub_nonneg.mpr hx.1) 12, pow_nonneg (sub_nonneg.mpr hx.1) 15, pow_nonneg (sub_nonneg.mpr hx.1) 18, pow_nonneg (sub_nonneg.mpr hx.1) 21, pow_nonneg (sub_nonneg.mpr hx.1) 24, pow_nonneg (sub_nonneg.mpr hx.2) 3, pow_nonneg (sub_nonneg.mpr hx.2) 6, pow_nonneg (sub_nonneg.mpr hx.2) 9, pow_nonneg (sub_nonneg.mpr hx.2) 12, pow_nonneg (sub_nonneg.mpr hx.2) 15, pow_nonneg (sub_nonneg.mpr hx.2) 18, pow_nonneg (sub_nonneg.mpr hx.2) 21, pow_nonneg (sub_nonneg.mpr hx.2) 24]\n","values":[-1.0,-1.0,-1.0,1.0,-0.3333333333333333,-0.05,-0.007936507936507936,-0.0010822510822510823,-0.0001554001554001554,-2.0567667626491154e-05,-2.835142154027603e-06,-3.698011505253395e-07,-1.0,-1.0,1.0,-0.3333333333333333,-0.05,-0.007936507936507936,-0.0010822510822510823,-0.0001554001554001554,-2.0567667626491154e-05,-2.835142154027603e-06,-3.698011505253395e-07,-0.5,1.0,-0.16666666666666666,-0.02857142857142857,-0.003968253968253968,-0.0005827505827505828,-7.77000777000777e-05,-1.082508822446903e-05,-1.4175710770138016e-06,-1.9229659827317656e-07,-0.5,0.3333333333333333,0.047619047619047616,0.005952380952380952,0.000777000777000777,9.990176326612164e-05,1.323127609042254e-05,1.7020307283209332e-06,2.2448603921322133e-07,-0.05,-0.007936507936507936,-0.0010822510822510823,-0.0001554001554001554,-2.0567667626491154e-05,-2.83