2],[18,-2],[17,-1],[16,-2],[15,-2],[14,-2],[13,-1],[6,98],[5,98],[4,49],[3,49],[2,98],[1,49]]],["eq",[[43,3],[42,3],[29,3],[28,3],[27,6],[26,3],[25,3],[12,1],[11,1],[10,1],[6,-14],[5,-14],[4,-7],[3,-7],[2,-14],[1,-7]]],["eq",[[43,-3],[42,-3],[29,-3],[28,-3],[27,-6],[26,-3],[25,-3],[12,-1],[11,-1],[10,-1],[6,14],[5,14],[4,7],[3,7],[2,14],[1,7]]],["eq",[[52,2],[51,2],[50,2],[49,2],[48,2],[47,1],[46,2],[45,1],[44,1],[38,1],[37,2],[36,1],[35,1],[34,2],[33,2],[32,1],[31,1],[30,1],[6,-14],[5,-14],[4,-7],[3,-7],[2,-14],[1,-7]]],["eq",[[52,-2],[51,-2],[50,-2],[49,-2],[48,-2],[47,-1],[46,-2],[45,-1],[44,-1],[38,-1],[37,-2],[36,-1],[35,-1],[34,-2],[33,-2],[32,-1],[31,-1],[30,-1],[6,14],[5,14],[4,7],[3,7],[2,14],[1,7]]],["le",[]],["le",[[40,-2],[39,-1],[23,2],[22,2],[21,2],[20,-1],[18,2],[16,-2],[15,-1],[13,-1]]],["le",[[41,-2],[39,-1],[23,2],[22,2],[21,2],[20,2],[18,-1],[17,-1],[15,-1],[14,-2]]],["le",[[24,-2],[23,2],[22,2],[21,2],[20,-1],[19,-2],[18,-1],[17,-1],[15,2],[13,-1]]],["le",[[13,-1]]],["le",[[18,-1]]],["le",[[15,-1]]],["eq",[[18,1],[15,1],[13,1],[1,-49]]],["eq",[[18,-1],[15,-1],[13,-1],[1,49]]],["eq",[[29,1],[25,1],[11,1],[1,-7]]],["eq",[[29,-1],[25,-1],[11,-1],[1,7]]],["eq",[[35,1],[31,1],[30,1],[1,-7]]],["eq",[[35,-1],[31,-1],[30,-1],[1,7]]],["le",[]],["le",[[24,2],[18,-1],[13,-1]]],["le",[[22,2],[18,-1],[15,-1]]],["le",[[16,2],[15,-1],[13,-1]]],["le",[[39,-1]]],["le",[[20,-1]]],["eq",[[39,1],[20,1],[18,1],[4,-49]]],["eq",[[39,-1],[20,-1],[18,-1],[4,49]]],["eq",[[43,1],[42,1],[10,1],[4,-7]]],["eq",[[43,-1],[42,-1],[10,-1],[4,7]]],["eq",[[47,1],[45,1],[44,1],[4,-7]]],["eq",[[47,-1],[45,-1],[44,-1],[4,7]]],["le",[]],["le",[[41,2],[39,-1],[18,-1]]],["le",[[40,2],[39,-1],[20,-1]]],["le",[[23,2],[20,-1],[18,-1]]],["le",[[17,-1]]],["eq",[[20,1],[17,1],[15,1],[3,-49]]],["eq",[[20,-1],[17,-1],[15,-1],[3,49]]],["eq",[[28,1],[26,1],[12,1],[3,-7]]],["eq",[[28,-1],[26,-1],[12,-1],[3,7]]],["eq",[[38,1],[36,1],[32,1],[3,-7]]],["eq",[[38,-1],[36,-1],[32,-1],[3,7]]],["le",[]],["le",[[21,2],[20,-1],[15,-1]]],["le",[[20,-1],[19,2],[17,-1]]],["le",[[17,-1],[15,-1],[14,2]]],["eq",[[39,-1],[20,-2],[18,-2],[17,-1],[15,-2],[13,-1],[4,98],[3,98],[1,98],[0,-2401]]],{"call":1452,"source":"set_option maxHeartbeats 0\n\nopen BigOperators Real Nat Topology Rat\n\n/- Prove that $\\frac{1}{\\sqrt{k+1}}<2(\\sqrt{k+1}-\\sqrt{k})<\\frac{1}{\\sqrt{k}}$. -/\ntheorem lean_workbook_21309 (k : ℕ) (h : 0 < k) :\n  (1 / Real.sqrt (k + 1)) < 2 * (Real.sqrt (k + 1) - Real.sqrt k) ∧\n    2 * (Real.sqrt (k + 1) - Real.sqrt k) < 1 / Real.sqrt k  := by\n  /-\n  We need to prove two inequalities involving square roots:\n  1. \\(\\frac{1}{\\sqrt{k+1}} < 2(\\sqrt{k+1} - \\sqrt{k})\\)\n  2. \\(2(\\sqrt{k+1} - \\sqrt{k}) < \\frac{1}{\\sqrt{k}}\\)\n  For the first inequality, we start by noting that since \\(k > 0\\), the square roots are positive. We then simplify the expression using algebraic manipulations and properties of square roots. Specifically, we use the fact that the square root of a difference of squares can be expressed in terms of the square roots of the individual terms. Finally, we use basic arithmetic and inequalities to establish the desired inequality.\n  For the second inequality, we again start by noting that the square roots are positive. We then simplify the expression using algebraic manipulations and properties of square roots. Finally, we use basic arithmetic and inequalities to establish the desired inequality.\n  -/\n  constructor\n  case left =>\n    -- We need to show that 1 / sqrt(k+1) < 2 * (sqrt(k+1) - sqrt(k))\n    -- Since k > 0, the square roots are positive.\n    have h₁ : 0 < Real.sqrt k := Real.sqrt_pos.mpr (by positivity)\n    have h₂ : 0 < Real.sqrt (k + 1) := Real.sqrt_pos.mpr (by linarith)\n    -- Simplify the expression using field operations and properties of square roots.\n    field_simp\n    rw [← sub_pos]\n    field_simp\n    -- Use basic arithmetic and inequalities to establish the desired inequality.\n    nlinarith [Real.mul_self_sqrt (by linarith : 0 ≤ (k : ℝ)),\n      Real.mul_self_sqrt (by linarith : 0 ≤ (k + 1 : ℝ))]\n  case right =>\n    -- We need to show that 2 * (sqrt(k+1) - sqrt(k)) < 1 / sqrt(k)\n    -- Since k > 0, the square roots are positive.\n    have h₁ : 0 < Real.sqrt k := Real.sqrt_pos.mpr (by positivity)\n    have h₂ : 0 < Real.sqrt (k + 1) := Real.sqrt_pos.mpr (by linarith)\n    -- Simplify the expression using field operations and properties of square roots.\n    field_simp\n    rw [← sub_pos]\n    field_simp\n    -- Use basic arithmetic and inequalities to establish the desired inequality.\n    nlinarith [Real.mul_self_sqrt (by linarith : 0 ≤ (k : ℝ)),\n      Real.mul_self_sqrt (by linarith : 0 ≤ (k + 1 : ℝ))]","route":"native"}
