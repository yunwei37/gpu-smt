inequality.\n  -/\n  -- Use non-linear arithmetic to handle the inequality involving polynomials.\n  -- We provide several non-negative expressions to ensure the tactic can correctly deduce the inequality.\n  nlinarith [sq_nonneg (a - 1), sq_nonneg (b - 1), sq_nonneg (c - 1),\n    mul_nonneg ha hb, mul_nonneg hb hc, mul_nonneg hc ha,\n    sq_nonneg (a - b), sq_nonneg (b - c), sq_nonneg (c - a)]\n","values":[-1.0,-1.0,1.0,1.0,-0.5,-0.5,-0.5,1.0,-1.0,-1.0,1.0,0.4,-0.4,0.4,-0.4,0.4,-0.4,-1.0,0.5,0.5,0.5,-0.16666666666666666,-0.25,-0.25,-0.16666666666666666,-0.25,-0.16666666666666666,-1.0,0.5,-0.5,1.0,1.0,-1.0,1.0,-0.5,-0.5,-0.5,-1.0,1.0,0.5,-0.5,-1.0,1.0,-0.2,0.2,-0.2,0.2,-1.0,0.6666666666666666,0.5,0.5,-1.0,0.5,-0.5,1.0,1.0,-1.0,1.0,-0.5,-0.5,-0.5,-1.0,1.0,0.5,-0.5,-0.2,0.2,-1.0,1.0,-0.2,0.2,-1.0,0.5,0.6666666666666666,0.5,-1.0,0.5,-0.5,1.0,1.0,-1.0,1.0,-0.5,-0.5,-0.5,-1.0,1.0,0.5,-0.5,-0.2,0.2,-0.2,0.2,-1.0,1.0,-1.0,0.5,0.5,0.6666666666666666,-0.5,-0.5,-0.5,-0.5,-1.0,-1.0,-0.5,0.5,1.0,0.25,-0.25,0.5,-0.5,0.8,-0.8,0.5,-0.5,0.5,-0.5,1.0,-1.0,1.0,0.25,-0.25,-0.25,0.5,0.5,1.0,-1.0,-0.25,-0.25,-0.25,-0.25,-0.5,-0.25,-0.25,-0.5,-0.25,-0.25,-0.5,0.16666666666666666,-0.5,-0.5,-0.5,-0.5,-1.0,-0.4166666666666667,0.4166666666666667,-0.2,0.2,-0.25,0.25,-0.25,0.25,-0.5,0.5,-0.3333333333333333,0.5833333333333334,0.08333333333333333,0.08333333333333333,0.6666666666666666,0.5,0.5,1.0,-0.020833333333333332,0.16666666666666666,0.10416666666666667,-0.10416666666666667,-0.20833333333333334,-0.4270833333333333,-0.010416666666666666,-0.010416666666666666,-0.25,-0.25,-0.5,-0.16666666666666666,-0.25,-0.25,-0.5,-0.16666666666666666,-0.25,-0.5,-0.16666666666666666,-0.5,-1.0,-0.041666666666666664,0.041666666666666664,-0.041666666666666664,-0.4166666666666667,-0.2708333333333333,-0.2708333333333333,-0.020833333333333332,-0.5,-0.25,-0.25,-0.5,-0.5,-0.25,-0.25,-0.25,-0.5,-0.25,-0.25,-0.5,-1.0,1.0,-1.0,-0.25,-0.25,-0.5,-0.5,-0.25,-0.5,-0.5,-1.0,-0.041666666666666664,0.041666666666666664,-0.0416666