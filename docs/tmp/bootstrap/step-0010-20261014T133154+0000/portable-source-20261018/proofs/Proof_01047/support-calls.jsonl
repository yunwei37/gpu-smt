^3+54a^2-12a+10&\\ge &0\\qquad\\Leftrightarrow\\\\ & & \\\\\\(a-1)^2\\cdot (a^7+8a^6+15a^5+102a^4+39a^3+60a^2+8a+10)&\\ge &0. \\end{array}$ But this is true for all $ a>0$ . -/\ntheorem lean_workbook_14369  (a : \u211d)\n  (h\u2080 : 0 < a) :\n  (a - 1)^2 * (a^7 + 8 * a^6 + 15 * a^5 + 102 * a^4 + 39 * a^3 + 60 * a^2 + 8 * a + 10) \u2265 0  := by\n  /-\n  The inequality can be proved in the following way:\n  \\[\n  \\frac{2}{(2+a)^3} + \\frac{1}{(2 + \\frac{1}{a^2})^3} \\ge \\frac{1}{9}\n  \\]\n  This is equivalent to:\n  \\[\n  \\frac{a^9 + 6a^8 + 12a^7 + 24a^6 + 24a^4 + 12a^2 + 2}{(2+a)^3(2a^2+1)^3} \\ge \\frac{1}{9}\n  \\]\n  Which simplifies to:\n  \\[\n  9 \\left( a^9 + 6a^8 + 12a^7 + 24a^6 + 24a^4 + 12a^2 + 2 \\right) - (2+a)^3 (2a^2+1)^3 \\ge 0\n  \\]\n  Further simplifying to:\n  \\[\n  a^9 + 6a^8 + 80a^6 - 150a^5 + 84a^4 - 73a^3 + 54a^2 - 12a + 10 \\ge 0\n  \\]\n  Finally, we prove that:\n  \\[\n  (a - 1)^2 \\cdot (a^7 + 8a^6 + 15a^5 + 102a^4 + 39a^3 + 60a^2 + 8a + 10) \\ge 0\n  \\]\n  This is true for all \\( a > 0 \\).\n  -/\n  -- Apply the product of non-negative numbers is non-negative.\n  apply mul_nonneg\n  -- The square of any real number is non-negative.\n  apply pow_two_nonneg\n  -- Use linear arithmetic to prove the non-negativity of the polynomial.\n  nlinarith [sq_nonneg (a - 1), sq_nonneg (a + 1), sq_nonneg (a^2 - 1), sq_nonneg (a^2 + 1), sq_nonneg (a^3 - 1), sq_nonneg (a^3 + 1), sq_nonneg (a^4 - 1), sq_nonneg (a^4 + 1), sq_nonneg (a^5 - 1), sq_nonneg (a^5 + 1), sq_nonneg (a^6 - 1), sq_nonneg (a^6 + 1), sq_nonneg (a^7 - 1), sq_nonneg (a^7 + 1), sq_nonneg (a^8 - 1), sq_nonneg (a^8 + 1), sq_nonneg (a^9 - 1), sq_nonneg (a^9 + 1)]\n","values":[-1.0,0.09803921568627451,-0.5,-0.5,-0.5,-0.5,-0.5,-0.5,-0.5,-0.5,-0.5,-0.5,-0.5,-0.5,-0.5,-0.5,-0.5,-0.5,-0.5,-0.5,-0.00706164818868724,0.06666666666666667,0.03875968992248062,0.07352941176470588,0.03676470588235294,0.05128205128205128,0.046948356807511735,0.05154639175257732,0.04672897196261682,0.049019607843